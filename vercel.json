{
  "version": 2,
  "builds": [
    {
      "src": "fabric-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "fabric-frontend/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "s-maxage=31536000,immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "@api_url"
  }
}